# Google OAuth web client ID used by zkLogin.
VITE_ZKLOGIN_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# This must exactly match an Authorized redirect URI in Google Cloud Console.
# For local Vite development, use the origin shown in your browser:
# http://localhost:5173/login
# or http://127.0.0.1:5173/login
VITE_ZKLOGIN_REDIRECT_URI=http://localhost:5173/login
