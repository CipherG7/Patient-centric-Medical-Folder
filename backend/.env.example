# ─── Sui Network ───────────────────────────────────────────
# Options: testnet | mainnet | localnet
SUI_NETWORK=testnet
# Legacy full node RPC URL (deprecated; use GraphQL/gRPC above)
SUI_RPC_URL=
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# ─── Admin / Operator Wallet ──────────────────────────────
# The Sui private key that holds AdminCap for institution_registry.
# For demo purposes, the backend signs all transactions with this key.
# Format: hex-encoded raw private key (64 hex chars) OR
#         base64-encoded Sui keypair (requires @mysten/sui Ed25519Keypair import)
ADMIN_PRIVATE_KEY=your_private_key_here

# The published package ID on-chain (after `sui client publish`)
PACKAGE_ID=0xe71078cd400f97aa12314ac5ac8ac423fced53f18a8dd01da860ebe8b914105d

# ─── Walrus Storage ────────────────────────────────────────
# Encrypted documents are stored as Walrus blobs by default.
WALRUS_ENABLED=true
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
# Set WALRUS_ENABLED=false only for local development.
WALRUS_LOCAL_DIR=./data/walrus

# ─── PostgreSQL ────────────────────────────────────────────
# Connection string for the off-chain database.
# Example: postgresql://user:password@localhost:5432/medical_history
DATABASE_URL=postgresql://localhost:5432/medical_history

# ─── Server ────────────────────────────────────────────────
PORT=4000

# ─── Auth ──────────────────────────────────────────────────
# Simple API key for demo auth; replace with JWT or OAuth in production.

# Session / JWT secret (used for user session tokens)
